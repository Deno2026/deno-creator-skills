{
  "description": "DenoMCP starter kit - after compaction, remind the agent to re-read the docs (tools/agent-hooks/compact_reminder.py)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent-hooks/compact_reminder.py\"",
            "commandWindows": "powershell -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) 'tools/agent-hooks/compact_reminder.py')\"",
            "statusMessage": "Reminder: re-read the docs after compaction",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
