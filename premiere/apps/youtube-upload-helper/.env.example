# Google OAuth credentials.
# These can also be entered via the /settings UI (saved under the external runtime root).
# Required for source/dev runs. Packaged Electron defaults to its userData/runtime folder.
DENO_UPLOAD_HELPER_RUNTIME_ROOT=C:/Users/<me>/AppData/Local/DenoCreatorSkills/youtube-upload-helper
# Optional when the app is launched from inside this monorepo; required for packaged runs.
DENO_PRODUCTION_ROOT=C:/path/to/this-kit
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Optional: fixed token for local agents/bots that call /api/agent-workspace.
# If omitted, the app creates .local/agent-workspace-token.txt on first token check.
STUDIO_UPLOADER_AGENT_WORKSPACE_TOKEN=
