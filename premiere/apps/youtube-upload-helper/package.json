{
  "name": "@deno/youtube-upload-helper",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "guard": "node scripts/guard-workspace.cjs",
    "dev": "npm run guard && next dev --hostname 127.0.0.1",
    "safety:source": "node scripts/artifact-safety.cjs --root . --mode source --budget-mb 64",
    "safety:standalone": "node scripts/artifact-safety.cjs --root .next/standalone --mode package --budget-mb 900",
    "safety:desktop-bundle": "node scripts/artifact-safety.cjs --root desktop-bundle --mode package --budget-mb 900",
    "safety:dist": "node scripts/artifact-safety.cjs --root dist-desktop --mode package --budget-mb 1200",
    "test:artifact-safety": "node --test --test-isolation=none scripts/artifact-safety.test.cjs",
    "build:web": "npm run guard && npm run safety:source && next build && node scripts/sanitize-standalone.cjs && npm run safety:standalone",
    "prepare:desktop": "npm run guard && npm run safety:standalone && node scripts/prepare-desktop.cjs && npm run safety:desktop-bundle",
    "build:desktop": "npm run build:web && npm run prepare:desktop && npm run desktop:pack",
    "build": "npm run build:web",
    "start": "npm run guard && next start --hostname 127.0.0.1",
    "lint": "npm run guard && eslint",
    "typecheck": "npm run guard && tsc --noEmit",
    "smoke:request-revision": "npm run guard && node scripts/smoke-upload-request-revision.mjs",
    "smoke:production-handoff": "npm run guard && tsx scripts/smoke-production-handoff.ts",
    "smoke:video-staging": "npm run guard && node scripts/smoke-video-staging.mjs",
    "smoke:youtube-language-policy": "npm run guard && node scripts/smoke-korean-first-language-policy.mjs",
    "smoke:korean-first-ready-gate": "npm run guard && node ../../packages/publishing-core/tests/smoke_helper_ready_gate.cjs",
    "smoke:thumbnail-preparation": "npm run guard && node scripts/smoke-thumbnail-preparation.mjs",
    "smoke:youtube-extension-sync-gate": "npm run guard && node scripts/smoke-youtube-extension-sync-gate.mjs",
    "smoke:caption-maintenance-safety": "npm run guard && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-caption-maintenance-safety.mjs",
    "desktop:dev": "npm run guard && concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && cross-env APP_URL=http://localhost:3000 electron .\"",
    "desktop:start": "npm run guard && cross-env NODE_ENV=production electron .",
    "desktop:pack": "npm run guard && npm run safety:desktop-bundle && electron-builder --win portable && node scripts/sanitize-electron-dist.cjs && npm run safety:dist"
  },
  "dependencies": {
    "@deno/runtime-paths": "file:../../packages/runtime-paths",
    "@anthropic-ai/sdk": "^0.97.1",
    "dotenv": "^17.4.2",
    "geist": "^1.7.0",
    "googleapis": "^171.4.0",
    "next": "16.2.4",
    "openai": "^6.38.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.denocreatorskills.youtube-upload-helper",
    "productName": "Deno YouTube Upload Helper",
    "asar": true,
    "files": [
      "electron/**/*",
      "desktop-bundle/**/*",
      "package.json",
      "!**/.local{,/**/*}",
      "!**/.env{,.*}",
      "!**/*.{mp4,mov,mkv,avi,webm,wav,mp3,srt}",
      "!**/*token*.json",
      "!**/*secret*.json",
      "!package-lock.json"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    }
  }
}
