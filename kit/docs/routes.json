{
  "schema_version": 1,
  "kit_version": "0.1.0",
  "how_to_read": "tasks 에서 작업 유형 하나를 고르고 read_order 를 번호 순서로 읽는다. <project> 는 감독이 지목한 작품 폴더(projects/<작품>), <model> 은 craft/guides/ 의 모델 가이드 이름이다. 실행이 막히면 이 파일을 손으로 읽어도 결과는 같다. AGENTS.md 는 언제나 먼저 읽은 상태다.",
  "limits": {
    "root_agent_max_bytes": 12288,
    "task_read_max_bytes": 65536
  },
  "generate_gate": "craft/gate.md",
  "tasks": {
    "new-project": {
      "description": "새 작품 시작 — 이야기·방향을 말로 확정하고 폴더를 만든다(생성 없음)",
      "read_order": [
        "craft/taste.md",
        "craft/doctrine.md",
        "projects/_template/README.md"
      ]
    },
    "resume": {
      "description": "감독이 지목한 작품 이어받기",
      "needs": [
        "project"
      ],
      "read_order": [
        "<project>/STATE.md",
        "<project>/BRIEF.md",
        "<project>/DECISIONS.md",
        "craft/taste.md"
      ]
    },
    "generate-video": {
      "description": "영상 클립 생성 준비와 실행 — 게이트가 항상 첫 문서. 준비만 하고 멈출 때도 이 유형",
      "needs": [
        "project",
        "model"
      ],
      "read_order": [
        "craft/gate.md",
        "craft/doctrine.md",
        "craft/taste.md",
        "craft/guides/<model>.md",
        "<project>/BRIEF.md",
        "<project>/STATE.md"
      ]
    },
    "generate-image": {
      "description": "앵커·참조 이미지 생성 준비와 실행 — 게이트가 항상 첫 문서. 준비만 하고 멈출 때도 이 유형",
      "needs": [
        "project"
      ],
      "read_order": [
        "craft/gate.md",
        "craft/doctrine.md",
        "craft/taste.md",
        "craft/guides/image-assets.md",
        "<project>/BRIEF.md",
        "<project>/STATE.md"
      ]
    },
    "review": {
      "description": "결과 회수, 규격 확인, 감독 전달",
      "needs": [
        "project"
      ],
      "read_order": [
        "craft/doctrine.md",
        "<project>/STATE.md"
      ]
    },
    "taste-update": {
      "description": "감독이 말한 취향·규칙을 알맞은 층에 기록",
      "read_order": [
        "craft/taste.md",
        "craft/doctrine.md"
      ]
    },
    "finish": {
      "description": "세션 마무리 — 정리, 장부, 보고",
      "read_order": [
        "docs/session.md"
      ]
    },
    "kit-update": {
      "description": "키트 갱신 — 정본·교리·가이드·도구만 바꾸고 감독의 것은 보존",
      "read_order": [
        "docs/session.md",
        ".denomcp/kit.json"
      ]
    }
  }
}
